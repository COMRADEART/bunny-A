      "finalSource": "def slugify(text):\n    result = []\n    non_alphanumeric = False\n    for char in text.lower():\n        if char.isalnum():\n            if non_alphanumeric:\n                result.append('-')\n                non_alphanumeric = False\n            result.append(char)\n        else:\n            non_alphanumeric = True\n    return ''.join(result).strip('-')\n",
      "skillId": "3b6999ed-7583-43ca-aab9-ca05975ace17"
    },
