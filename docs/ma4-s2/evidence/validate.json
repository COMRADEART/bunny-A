      "finalSource": "def median(xs):\n    if not xs:\n        raise ValueError('The list is empty')\n    \n    sorted_xs = sorted(xs)\n    n = len(sorted_xs)\n    mid = n // 2\n    \n    if n % 2 == 1:\n        return sorted_xs[mid]\n    else:\n        return (sorted_xs[mid - 1] + sorted_xs[mid]) / 2\n",
