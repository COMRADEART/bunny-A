      "finalSource": "def merge_intervals(pairs):\n    if not pairs:\n        return []\n    \n    # Sort the pairs by the start value\n    pairs.sort()\n    \n    merged = [pairs[0]]\n    \n    for start, end in pairs[1:]:\n        if start > end:\n            raise ValueError(\"Invalid interval: start > end\")\n        \n        last_start, last_end = merged[-1]\n        \n        if start < last_end:  # Corrected condition to strictly merge\n            # Merge the current interval with the last interval\n            merged[-1] = (last_start, max(last_end, end))\n        else:\n            # Append the current interval to the merged list\n            merged.append((start, end))\n    \n    return merged\n",
      "skillId": "87a6e429-6db0-4cd4-bddd-92b87e2dc017"
    },
