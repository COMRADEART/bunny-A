      "finalSource": "import re\nimport calendar\n\ndef parse_date(text):\n    # Regular expression pattern to match the date format YYYY-MM-DD\n    date_pattern = r'^\\d{4}-\\d{2}-\\d{2}$'\n    \n    # Check if the input text matches the date pattern\n    if not re.match(date_pattern, text):\n        raise ValueError('Invalid date format')\n    \n    # Split the input text by hyphens to extract the year, month, and day as strings\n    year, month, day = map(int, text.split('-'))\n    \n    # Validate the month and day values\n    if month < 1 or month > 12:\n        raise ValueError('Month out of range')\n    if day < 1 or day > calendar.monthrange(year, month)[1]:\n        raise ValueError('Day out of range')\n    \n    # Return the year, month, and day as integers in a tuple\n    return year, month, day\n",
