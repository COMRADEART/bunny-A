      "finalSource": "def split_csv_line(line):\n    fields = []\n    in_quotes = False\n    current_field = []\n    \n    for char in line:\n        if char == '\"':\n            if in_quotes:\n                if len(current_field) > 1 and current_field[-2] == '\"':\n                    current_field[-2:] = ['\"']\n                else:\n                    in_quotes = False\n            else:\n                in_quotes = True\n        elif char == ',' and not in_quotes:\n            fields.append(''.join(current_field))\n            current_field = []\n        else:\n            current_field.append(char)\n    \n    if in_quotes:\n        raise ValueError(\"Unclosed quote\")\n    \n    fields.append(''.join(current_field))\n    return fields\n",
