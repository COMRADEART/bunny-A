      "finalSource": "# duration.py\nimport re\nfrom typing import Optional\n\n# Mapping from unit to its multiplier in seconds\n_UNIT_SECONDS = {\n    'h': 3600,\n    'm': 60,\n    's': 1,\n}\n\n# Pre‑compiled regular expression that enforces the required order and uniqueness.\n# Each unit is optional but may appear only once and must be in the order h‑m‑s.\n_DURATION_RE = re.compile(\n    r'^'                     # start of string\n    r'(?:(?P<h>\\d+)h)?'      # optional hours\n    r'(?:(?P<m>\\d+)m)?'      # optional minutes\n    r'(?:(?P<s>\\d+)s)?'      # optional seconds\n    r'$'                     # end of string\n)\n\ndef parse_duration(text: str) -> int:\n    \"\"\"\n    Convert a duration string into whole seconds.\n\n    The string must consist of one or more parts of the form\n    <non‑negative integer><unit>, where unit is one of 'h', 'm', 's'.\n    Units must appear in the order hours → minutes → seconds,\n    each at most once, and without any spaces.\n\n    Parameters\n    ----------\n    text: str\n        The duration string to parse.\n\n    Returns\n    -------\n    int\n        The total number of seconds represented by the input.\n\n    Raises\n    ------\n    ValueError\n        If the input does not conform to the required format.\n    \"\"\"\n    if not isinstance(text, str):\n        raise ValueError(\"Input must be a string\")\n\n    match = _DURATION_RE.fullmatch(text)\n    if not match:\n        raise ValueError(f\"Invalid duration format: {text!r}\")\n\n    # Ensure at least one component is present\n    if not any(match.group(name) is not None for name in ('h', 'm', 's')):\n        raise ValueError(f\"Invalid duration format: {text!r}\")\n\n    total_seconds = 0\n    for unit, multiplier in _UNIT_SECONDS.items():\n        value_str: Optional[str] = match.group(unit)\n        if value_str is not None:\n            # The regex guarantees that value_str consists only of digits\n            total_seconds += int(value_str) * multiplier\n\n    return total_seconds\n",
