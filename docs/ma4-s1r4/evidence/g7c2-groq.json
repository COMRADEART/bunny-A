      "finalSource": "import re\nfrom typing import Final\n\n# Mapping from unit to its multiplier in seconds\n_UNIT_SECONDS: Final[dict[str, int]] = {\n    \"h\": 3600,\n    \"m\": 60,\n    \"s\": 1,\n}\n\n# Pre‑compiled regular expression that enforces:\n#   - optional hours, then optional minutes, then optional seconds\n#   - each part is a sequence of digits followed by its unit\n#   - at least one part must be present\n_DURATION_RE: Final[re.Pattern] = re.compile(\n    r\"\"\"^\n        (?:\n            (?P<h>\\d+)h\n        )?\n        (?:\n            (?P<m>\\d+)m\n        )?\n        (?:\n            (?P<s>\\d+)s\n        )?\n        $\"\"\",\n    re.VERBOSE,\n)\n\n\ndef parse_duration(text: str) -> int:\n    \"\"\"\n    Parse a duration string and return the total number of seconds.\n\n    The string must consist of one or more parts of the form\n    <non‑negative integer><unit> where unit is one of 'h', 'm', 's'.\n    Parts must appear in the order hours → minutes → seconds,\n    each unit may appear at most once, and no whitespace is allowed.\n\n    Parameters\n    ----------\n    text: str\n        The duration string to parse.\n\n    Returns\n    -------\n    int\n        Total duration in whole seconds.\n\n    Raises\n    ------\n    ValueError\n        If the input does not conform to the required format.\n    \"\"\"\n    if not isinstance(text, str):\n        raise ValueError(\"Input must be a string\")\n\n    match = _DURATION_RE.fullmatch(text)\n    if not match:\n        raise ValueError(\"Invalid duration format\")\n\n    # Ensure at least one component was captured\n    if not any(match.group(name) is not None for name in (\"h\", \"m\", \"s\")):\n        raise ValueError(\"Duration string cannot be empty\")\n\n    total_seconds = 0\n    for unit, multiplier in _UNIT_SECONDS.items():\n        value_str = match.group(unit)\n        if value_str is not None:\n            # The regex guarantees value_str consists only of digits\n            total_seconds += int(value_str) * multiplier\n\n    return total_seconds\n",
