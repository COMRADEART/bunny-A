      "finalSource": "import re\nfrom typing import Final\n\n# Mapping from unit to its multiplier in seconds\n_UNIT_MULTIPLIER: Final[dict[str, int]] = {\n    \"h\": 3600,\n    \"m\": 60,\n    \"s\": 1,\n}\n\n# Regular expression that captures a sequence of <digits><unit>\n_PART_RE: Final[re.Pattern] = re.compile(r\"(\\d+)([hms])\")\n\n\ndef parse_duration(text: str) -> int:\n    \"\"\"\n    Convert a duration string into whole seconds.\n\n    The string must consist of one or more parts of the form\n    <non‑negative integer><unit>, where unit is one of 'h', 'm', 's'.\n    Parts must appear in the order h → m → s, each unit at most once,\n    and the string must contain no spaces or other characters.\n\n    Parameters\n    ----------\n    text: str\n        The duration string to parse.\n\n    Returns\n    -------\n    int\n        Total number of seconds represented by the string.\n\n    Raises\n    ------\n    ValueError\n        If the string is empty or does not conform to the required format.\n    \"\"\"\n    if not text:\n        raise ValueError(\"Duration string is empty\")\n\n    # Find all parts\n    parts = list(_PART_RE.finditer(text))\n    if not parts:\n        raise ValueError(\"No valid duration parts found\")\n\n    # Verify that the concatenation of all matches equals the original text\n    concatenated = \"\".join(m.group(0) for m in parts)\n    if concatenated != text:\n        raise ValueError(\"Invalid characters or spacing in duration string\")\n\n    seen_units = set()\n    last_index = -1  # index in the order list of the previous unit\n\n    total_seconds = 0\n    for match in parts:\n        number_str, unit = match.group(1), match.group(2)\n\n        # Check for repeated unit\n        if unit in seen_units:\n            raise ValueError(f\"Unit '{unit}' appears more than once\")\n        seen_units.add(unit)\n\n        # Enforce correct order (h before m before s)\n        current_index = (\"h\", \"m\", \"s\").index(unit)\n        if current_index <= last_index:\n            raise ValueError(\"Units are out of order\")\n        last_index = current_index\n\n        # Convert number to int (regex guarantees digits)\n        value = int(number_str)\n\n        # Compute seconds for this part\n        total_seconds += value * _UNIT_MULTIPLIER[unit]\n\n    return total_seconds\n",
