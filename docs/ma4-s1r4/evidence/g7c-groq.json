      "finalSourceSha256": "6ca3062f73c053180761902cd6541d43a7294657eab2216098a3e40091cbb967",
      "finalSource": "# duration.py\nimport re\nfrom typing import Final\n\n__all__: Final = [\"parse_duration\"]\n\n# Regular expression that captures optional hour, minute and second parts\n# in the required order. Each part is a sequence of digits followed by its unit.\n_PATTERN: Final = re.compile(r'^(?:(\\d+)h)?(?:(\\d+)m)?(?:(\\d+)s)?$')\n\n\ndef parse_duration(text: str) -> int:\n    \"\"\"\n    Convert a duration string to a total number of whole seconds.\n\n    The accepted format is one or two concatenated parts of the form\n    <non‑negative integer><unit>, where unit is one of:\n        h – hours\n        m – minutes\n        s – seconds\n    Units must appear in the order h, m, s and each may appear at most once.\n    Strings containing all three units, spaces, unknown units, missing numbers,\n    empty strings, or any other deviation raise ValueError.\n\n    Parameters\n    ----------\n    text: str\n        The duration string to parse.\n\n    Returns\n    -------\n    int\n        Total seconds represented by the input string.\n\n    Raises\n    ------\n    ValueError\n        If the input does not conform to the required format.\n    \"\"\"\n    if not isinstance(text, str):\n        raise ValueError(\"Input must be a string\")\n\n    match = _PATTERN.fullmatch(text)\n    if not match:\n        raise ValueError(\"Invalid duration format\")\n\n    hour_str, minute_str, second_str = match.groups()\n\n    # At least one part must be present\n    if hour_str is None and minute_str is None and second_str is None:\n        raise ValueError(\"Duration string is empty\")\n\n    # Disallow all three units simultaneously\n    parts_present = sum(part is not None for part in (hour_str, minute_str, second_str))\n    if parts_present > 2:\n        raise ValueError(\"Too many units; at most two are allowed\")\n\n    total_seconds = 0\n    if hour_str is not None:\n        total_seconds += int(hour_str) * 3600\n    if minute_str is not None:\n        total_seconds += int(minute_str) * 60\n    if second_str is not None:\n        total_seconds += int(second_str)\n\n    return total_seconds\n",
