      "finalSourceSha256": "728a7559c0e933afa377a70af371214d409bfc5ae33ccf4eee8f904724296e61",
      "finalSource": "import re\nfrom typing import Final\n\n# Regular expression that matches the allowed format:\n# optional hours, optional minutes, optional seconds, in that exact order.\n# At least one of the three groups must be present.\n_DURATION_RE: Final[re.Pattern] = re.compile(\n    r'^(?:(\\d+)h)?(?:(\\d+)m)?(?:(\\d+)s)?$'\n)\n\n# Conversion factors to seconds.\n_UNIT_SECONDS: Final[dict[str, int]] = {\n    'h': 3600,\n    'm': 60,\n    's': 1,\n}\n\n\ndef parse_duration(text: str) -> int:\n    \"\"\"\n    Convert a duration string into whole seconds.\n\n    The string must consist of one or more parts of the form\n    <non‑negative integer><unit>, where unit is one of 'h', 'm', 's'.\n    Units must appear in the order h, m, s and each may appear at most once.\n    No spaces or other characters are permitted.\n\n    Parameters\n    ----------\n    text: str\n        The duration string to parse.\n\n    Returns\n    -------\n    int\n        The total number of seconds represented by the input.\n\n    Raises\n    ------\n    ValueError\n        If the input does not conform to the required format.\n    \"\"\"\n    if not isinstance(text, str):\n        raise ValueError(\"Input must be a string\")\n\n    match = _DURATION_RE.fullmatch(text)\n    if not match:\n        raise ValueError(\"Invalid duration format\")\n\n    # Extract the three possible groups.\n    hours_str, minutes_str, seconds_str = match.groups()\n\n    # Ensure at least one part is present.\n    if hours_str is None and minutes_str is None and seconds_str is None:\n        raise ValueError(\"Duration string is empty\")\n\n    total_seconds = 0\n    if hours_str is not None:\n        total_seconds += int(hours_str) * _UNIT_SECONDS['h']\n    if minutes_str is not None:\n        total_seconds += int(minutes_str) * _UNIT_SECONDS['m']\n    if seconds_str is not None:\n        total_seconds += int(seconds_str) * _UNIT_SECONDS['s']\n\n    return total_seconds\n",
