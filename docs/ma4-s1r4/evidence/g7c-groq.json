      "finalSource": "import re\nfrom typing import Final, Dict\n\n# Mapping of unit to its multiplier in seconds\n_UNIT_SECONDS: Final[Dict[str, int]] = {\n    'h': 3600,\n    'm': 60,\n    's': 1,\n}\n\n# Order index for each unit to enforce h → m → s ordering\n_UNIT_ORDER: Final[Dict[str, int]] = {\n    'h': 0,\n    'm': 1,\n    's': 2,\n}\n\n\ndef parse_duration(text: str) -> int:\n    \"\"\"\n    Convert a duration string into whole seconds.\n\n    The string must consist of one or two parts, each part being\n    <non‑negative integer><unit> where unit is one of 'h', 'm', 's'.\n    Units must appear in the order h, m, s and each may be used at most\n    once.  The combination of all three units is considered invalid.\n\n    Parameters\n    ----------\n    text: str\n        Duration description (e.g., \"1h30m\", \"45s\", \"2h5s\").\n\n    Returns\n    -------\n    int\n        Total number of seconds represented by the input.\n\n    Raises\n    ------\n    ValueError\n        If the input does not conform to the required format.\n    \"\"\"\n    if not isinstance(text, str):\n        raise ValueError(\"Input must be a string\")\n\n    # Find all <number><unit> fragments\n    pattern = re.compile(r'(\\d+)([hms])')\n    matches = list(pattern.finditer(text))\n\n    # No matches → invalid (including empty string)\n    if not matches:\n        raise ValueError(\"Invalid duration format\")\n\n    # Ensure the entire string is exactly the concatenation of the matches\n    reconstructed = ''.join(m.group(0) for m in matches)\n    if reconstructed != text:\n        raise ValueError(\"Invalid characters or spacing in duration string\")\n\n    total_seconds = 0\n    seen_units = set()\n    last_order = -1\n\n    for m in matches:\n        number_str, unit = m.group(1), m.group(2)\n\n        # Convert number; leading zeros are allowed\n        number = int(number_str)\n\n        # Unit must be one of the allowed ones (guaranteed by regex)\n        if unit in seen_units:\n            raise ValueError(\"Repeated unit in duration string\")\n        seen_units.add(unit)\n\n        # Enforce correct ordering\n        order = _UNIT_ORDER[unit]\n        if order < last_order:\n            raise ValueError(\"Units out of order\")\n        last_order = order\n\n        total_seconds += number * _UNIT_SECONDS[unit]\n\n    # Disallow the combination of all three units\n    if seen_units == {'h', 'm', 's'}:\n        raise ValueError(\"All three units present is not allowed\")\n\n    return total_seconds\n",
