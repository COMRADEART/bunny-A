<Application x:Class="BunnyA.App" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="BackgroundBrush" Color="#161618"/>
    <SolidColorBrush x:Key="PanelBrush" Color="#29292D"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F5F5F7"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#C5C5CC"/>
    <Style TargetType="Button"><Setter Property="Foreground" Value="#171719"/><Setter Property="Background" Value="#F5F5F7"/><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="16,8"/><Setter Property="Margin" Value="0,12,0,0"/></Style>
  </Application.Resources>
</Application>
