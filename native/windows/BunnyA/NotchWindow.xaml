<Window x:Class="BunnyA.NotchWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Bunny Island Notch"
        WindowStyle="None"
        AllowsTransparency="True"
        Topmost="True"
        ShowInTaskbar="False"
        Background="Transparent"
        FontFamily="Segoe UI"
        SizeToContent="WidthAndHeight"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
  <Border x:Name="NotchBorder"
          Background="#D8141824"
          BorderBrush="{StaticResource GlassEdgeBrush}"
          BorderThickness="1.5"
          CornerRadius="24"
          Padding="14,8"
          Margin="12"
          Effect="{DynamicResource ShadowEffect}">
    <Border.Resources>
      <DropShadowEffect x:Key="ShadowEffect" BlurRadius="24" ShadowDepth="4" Direction="270" Color="#000000" Opacity="0.55"/>
    </Border.Resources>
    
    <Grid x:Name="NotchLayoutGrid">
      <!-- Horizontal Notch Layout (Top / Bottom) -->
      <StackPanel x:Name="HorizontalLayout" Orientation="Horizontal" VerticalAlignment="Center">
        <!-- Agent indicators reflow to the LEFT for horizontal notch -->
        <StackPanel x:Name="HorizontalAgentsPanel" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,14,0">
          <!-- Gada -->
          <Border x:Name="GadaBadge" ToolTip="Gada (Slot 1)" Background="#20FFFFFF" CornerRadius="16" Width="32" Height="32" Margin="2,0" BorderThickness="1.5" BorderBrush="#3550D6">
            <Image Source="pack://application:,,,/Assets/characters/gada.compact.png" Stretch="Uniform" Margin="3" AutomationProperties.AutomationId="AgentGada" AutomationProperties.Name="Gada"/>
          </Border>
          <!-- Spear -->
          <Border x:Name="SpearBadge" ToolTip="Spear (Slot 2)" Background="#20FFFFFF" CornerRadius="16" Width="32" Height="32" Margin="2,0" BorderThickness="1.5" BorderBrush="#2C3652">
            <Image Source="pack://application:,,,/Assets/characters/spear.compact.png" Stretch="Uniform" Margin="3" AutomationProperties.AutomationId="AgentSpear" AutomationProperties.Name="Spear"/>
          </Border>
          <!-- Chakra -->
          <Border x:Name="ChakraBadge" ToolTip="Vishnu Chakra (Slot 3)" Background="#20FFFFFF" CornerRadius="16" Width="32" Height="32" Margin="2,0" BorderThickness="1.5" BorderBrush="#2C3652">
            <Image Source="pack://application:,,,/Assets/characters/chakra.compact.png" Stretch="Uniform" Margin="3" AutomationProperties.AutomationId="AgentChakra" AutomationProperties.Name="Chakra"/>
          </Border>
          <!-- Sword -->
          <Border x:Name="SwordBadge" ToolTip="Sword (Slot 4)" Background="#20FFFFFF" CornerRadius="16" Width="32" Height="32" Margin="2,0" BorderThickness="1.5" BorderBrush="#2C3652">
            <Image Source="pack://application:,,,/Assets/characters/sword.compact.png" Stretch="Uniform" Margin="3" AutomationProperties.AutomationId="AgentSword" AutomationProperties.Name="Sword"/>
          </Border>
        </StackPanel>

        <!-- Bunny Avatar -->
        <Border CornerRadius="18" Width="36" Height="36" Background="#26304D" BorderThickness="1" BorderBrush="#5B6CFF" Margin="0,0,10,0">
          <Image x:Name="BunnyAvatar" Source="pack://application:,,,/Assets/characters/bunny.idle.png" Stretch="Uniform" Margin="3"/>
        </Border>

        <!-- Status & Activity Capsule -->
        <StackPanel VerticalAlignment="Center" Margin="0,0,12,0" MaxWidth="280">
          <TextBlock x:Name="NotchTitle" Text="Bunny A · Ready" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource TextBrush}"/>
          <TextBlock x:Name="NotchSubtitle" Text="Idle · 4 agents standing by" FontSize="11" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <!-- Pending Approval Alert Badge (Visible when approvals wait) -->
        <Border x:Name="ApprovalBadge" Visibility="Collapsed" Background="{StaticResource WarningBrush}" CornerRadius="12" Padding="8,2" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="ApprovalBadge_Click">
          <StackPanel Orientation="Horizontal">
            <TextBlock Text="⚠️ Approval Needed" FontSize="11" FontWeight="Bold" Foreground="#121726"/>
          </StackPanel>
        </Border>

        <!-- Voice Indicator Pill -->
        <Border x:Name="VoicePill" Background="#1C2438" CornerRadius="12" Padding="8,4" Margin="0,0,8,0" Cursor="Hand" MouseLeftButtonUp="VoicePill_Click">
          <TextBlock x:Name="VoiceStatusText" Text="🎙️ Voice" FontSize="11" FontWeight="Medium" Foreground="{StaticResource MutedBrush}"/>
        </Border>

        <!-- Quick Stop Button -->
        <Button x:Name="QuickStopButton" Content="⏹ Stop" Style="{StaticResource DangerButtonStyle}" MinHeight="28" Padding="8,2" Margin="0,0,6,0" FontSize="11" Click="QuickStop_Click" Visibility="Collapsed"/>

        <!-- Expand / Window Toggle -->
        <Button x:Name="OpenWindowButton" Content="⤢ Open" Style="{StaticResource {x:Type Button}}" MinHeight="28" Padding="8,2" FontSize="11" Click="OpenWindow_Click"/>
        
        <!-- Edge Switcher Dropdown / Button -->
        <Button x:Name="DockEdgeButton" Content="⚓ Edge" ToolTip="Switch Dock Edge (Top, Bottom, Left, Right)" MinHeight="28" Padding="6,2" Margin="4,0,0,0" FontSize="11" Click="DockEdge_Click"/>
      </StackPanel>

      <!-- Vertical Notch Layout (Left / Right) -->
      <StackPanel x:Name="VerticalLayout" Orientation="Vertical" HorizontalAlignment="Center" Visibility="Collapsed">
        <!-- Agent indicators reflow to the TOP for vertical notch -->
        <StackPanel x:Name="VerticalAgentsPanel" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,0,0,10">
          <Border x:Name="VGadaBadge" ToolTip="Gada (Slot 1)" Background="#20FFFFFF" CornerRadius="14" Width="28" Height="28" Margin="0,2" BorderThickness="1.5" BorderBrush="#3550D6">
            <Image Source="pack://application:,,,/Assets/characters/gada.compact.png" Stretch="Uniform" Margin="2" AutomationProperties.AutomationId="VAgentGada" AutomationProperties.Name="Gada"/>
          </Border>
          <Border x:Name="VSpearBadge" ToolTip="Spear (Slot 2)" Background="#20FFFFFF" CornerRadius="14" Width="28" Height="28" Margin="0,2" BorderThickness="1.5" BorderBrush="#2C3652">
            <Image Source="pack://application:,,,/Assets/characters/spear.compact.png" Stretch="Uniform" Margin="2" AutomationProperties.AutomationId="VAgentSpear" AutomationProperties.Name="Spear"/>
          </Border>
          <Border x:Name="VChakraBadge" ToolTip="Vishnu Chakra (Slot 3)" Background="#20FFFFFF" CornerRadius="14" Width="28" Height="28" Margin="0,2" BorderThickness="1.5" BorderBrush="#2C3652">
            <Image Source="pack://application:,,,/Assets/characters/chakra.compact.png" Stretch="Uniform" Margin="2" AutomationProperties.AutomationId="VAgentChakra" AutomationProperties.Name="Chakra"/>
          </Border>
          <Border x:Name="VSwordBadge" ToolTip="Sword (Slot 4)" Background="#20FFFFFF" CornerRadius="14" Width="28" Height="28" Margin="0,2" BorderThickness="1.5" BorderBrush="#2C3652">
            <Image Source="pack://application:,,,/Assets/characters/sword.compact.png" Stretch="Uniform" Margin="2" AutomationProperties.AutomationId="VAgentSword" AutomationProperties.Name="Sword"/>
          </Border>
        </StackPanel>

        <!-- Bunny Avatar -->
        <Border CornerRadius="16" Width="32" Height="32" Background="#26304D" BorderThickness="1" BorderBrush="#5B6CFF" Margin="0,0,0,8">
          <Image x:Name="VBunnyAvatar" Source="pack://application:,,,/Assets/characters/bunny.idle.png" Stretch="Uniform" Margin="2"/>
        </Border>

        <!-- Vertical Action Buttons -->
        <Button x:Name="VOpenWindowButton" Content="⤢" ToolTip="Open Bunny A Window" MinHeight="26" Width="26" Padding="0" Click="OpenWindow_Click" Margin="0,2"/>
        <Button x:Name="VDockEdgeButton" Content="⚓" ToolTip="Switch Dock Edge" MinHeight="26" Width="26" Padding="0" Click="DockEdge_Click" Margin="0,2"/>
      </StackPanel>
    </Grid>
  </Border>
</Window>
